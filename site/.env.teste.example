# =============================================================================
# TESTE / HOMOLOGAÇÃO (ex.: teste.nfsolucoesdigitais.com.br) — ramo "teste" do GitHub
#
# Este arquivo é só um MODELO, sem valores reais. Os valores de verdade ficam nas
# variáveis de ambiente do app de TESTE no hPanel da Hostinger, nunca no GitHub.
#
# Regra: variável com NEXT_PUBLIC_ vai para o navegador (qualquer pessoa vê).
#        Senhas e chaves NUNCA têm esse prefixo (a compilação é barrada se tiverem).
# =============================================================================

# --- Públicas (aparecem no navegador; nada secreto aqui) ---
NEXT_PUBLIC_AMBIENTE=teste
# No teste, login, cadastro e carrinho ficam ligados para serem testados antes da produção
NEXT_PUBLIC_CONTAS_ATIVAS=true

# --- Secretas (só no servidor) ---
# Usuário e senha que o navegador pede para abrir o site de teste (senha com 12+ caracteres)
TESTE_USUARIO=equipe-nf
TESTE_SENHA=troque-por-uma-senha-forte

# Banco de TESTE: separado do de produção, só com dados fictícios (nunca copie clientes reais)
DATABASE_URL=mysql://USUARIO_TESTE:SENHA_TESTE@localhost:3306/NOME_DO_BANCO_TESTE
# Chaves aleatórias de 32+ caracteres, DIFERENTES das da produção
LIMITE_LOGIN_SEGREDO=gere-uma-chave-aleatoria-de-32-ou-mais-caracteres
SESSAO_SEGREDO=gere-outra-chave-aleatoria-de-32-ou-mais-caracteres
# E-mail de envio: no teste, os avisos vão para a equipe, não para o administrador real
SMTP_HOST=smtp.hostinger.com
SMTP_USUARIO=naoresponda@nfsolucoesdigitais.com.br
SMTP_SENHA=senha-da-caixa-de-email
EMAIL_ADMINISTRADOR=email-da-equipe-de-testes@exemplo.com.br
