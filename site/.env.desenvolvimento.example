# =============================================================================
# DESENVOLVIMENTO (no seu computador, `npm run dev`)
#
# Copie este arquivo para ".env.local" (que o Git ignora) e ajuste se precisar.
# =============================================================================

NEXT_PUBLIC_AMBIENTE=desenvolvimento
NEXT_PUBLIC_CONTAS_ATIVAS=true

# Banco local de desenvolvimento (MariaDB no computador), com dados fictícios
DATABASE_URL=mysql://root:SENHA_LOCAL@127.0.0.1:3307/nf_solucoes
LIMITE_LOGIN_SEGREDO=chave-local-qualquer-com-32-ou-mais-caracteres
SESSAO_SEGREDO=outra-chave-local-qualquer-com-32-ou-mais-caracteres
