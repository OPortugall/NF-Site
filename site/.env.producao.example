# =============================================================================
# PRODUÇÃO (nfsolucoesdigitais.com.br) — ramo "main" do GitHub
#
# Este arquivo é só um MODELO, sem valores reais. Os valores de verdade ficam nas
# variáveis de ambiente do app de PRODUÇÃO no hPanel da Hostinger, nunca no GitHub.
#
# Regra: variável com NEXT_PUBLIC_ vai para o navegador (qualquer pessoa vê).
#        Senhas e chaves NUNCA têm esse prefixo (a compilação é barrada se tiverem).
# =============================================================================

# --- Públicas (aparecem no navegador; nada secreto aqui) ---
NEXT_PUBLIC_AMBIENTE=producao
# Login, cadastro e carrinho: false enquanto o servidor/banco não estiverem prontos (só vitrine)
NEXT_PUBLIC_CONTAS_ATIVAS=false

# --- Secretas (só no servidor) — usadas quando o login for ligado ---
# Banco de PRODUÇÃO (diferente do de teste!)
DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO
# Chaves aleatórias de 32+ caracteres, DIFERENTES das do teste
LIMITE_LOGIN_SEGREDO=gere-uma-chave-aleatoria-de-32-ou-mais-caracteres
SESSAO_SEGREDO=gere-outra-chave-aleatoria-de-32-ou-mais-caracteres
# E-mail de envio (confirmação de cadastro, nova senha, avisos ao administrador)
SMTP_HOST=smtp.hostinger.com
SMTP_USUARIO=naoresponda@nfsolucoesdigitais.com.br
SMTP_SENHA=senha-da-caixa-de-email
EMAIL_ADMINISTRADOR=contato@nfsolucoesdigitais.com.br
