<?xml version="1.0" encoding="utf-8"?>
<extension version="3.1" type="template" client="site">
        <name>nfsolucoes</name>
        <creationDate>Janeiro 2016</creationDate>
        <author>Recstore</author>
        <authorEmail>contato@recstoreinformatica.com.br</authorEmail>
        <authorUrl>http://www.recstoreinformatica.com.br</authorUrl>
        <copyright>Copyright Info  Recstore</copyright>
        <license>License Info  Recstore</license>
        <version>1.0.0</version>
        <description><![CDATA[
                CTHthemes Cashemir - Responsive One Page Joomla Portfolio Template. Info and Support: <a href="mailto:cththemes@gmail.com">cththemes@gmail.com</a> - <a href="index.php?option=com_templates">Go to Template Manager</a> 
            ]]></description>
        <files>
				<filename>component.php</filename>
				<filename>error.php</filename>
                <filename>index.html</filename>
                <filename>index.php</filename>
                <filename>template_preview.png</filename>
                <filename>template_thumbnail.png</filename>
                <filename>templateDetails.xml</filename>
            <folder>fonts</folder>
			<folder>html</folder>
            <folder>language</folder>
			<folder>images</folder>
			<folder>css</folder>
            <folder>css-personal</folder>
            <folder>css-sticky</folder>
            <folder>js</folder>
            <folder>js-personal</folder>
            <folder>js-sticky</folder>
        </files>
		<languages folder="language">
			<language tag="en-GB">en-GB/en-GB.tpl_cashemir.ini</language>
			<language tag="en-GB">en-GB/en-GB.tpl_cashemir.sys.ini</language>
		</languages>
        <positions>
            <position>navigation</position>
            <position>social-list</position>
            <position>main-menu</position>
            <position>breadcrumbs</position>
            <position>left-sidebar</position>
            <position>position-8</position>
            <position>right-sidebar</position>
            <position>position-7</position>
            <position>position-1</position>
            <position>position-2</position>
            <position>position-3</position>
            <position>position-4</position>
            <position>position-5</position>
            <position>position-6</position>
            <position>position-9</position>
            <position>footer</position>
            <position>footer-contactform</position>
            <position>footer-contactdetails</position>
            <position>footer-gmap</position>
            <position>footer-copyright</position>
            <position>sticky-menu</position>
            <position>sticky-azura</position>
            <position>debug</position>
        </positions>
        
         <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="favicon" type="media" label="Favicon"
                    description="Favicon" directory=""/>
                <field name="logoImage" type="media" label="Logo Image"
                    description="Logo Image" directory=""/>
                <field name="logoText" type="text" label="Logo Text"
                    description="Logo Text" default="Cashemir"/>
                <field name="preMadeSkin" type="list" label="Pre Made Skin Color"
                    description="Pre Made Skin Color" default="default">
                    <option value="default">Default</option>
                    <option value="blue">Blue</option>
                    <option value="green">Green</option>
                    <option value="yellow">Yellow</option>
                    <option value="orange">Orange</option>
                </field>
                <field name="skin" type="list" label="Template Skin"
                    description="Template Skin" class="inputbox" default="team">
                    <option value="team">Team</option>
                    <option value="personal">Personal</option>
                    <option value="sticky">Sticky</option>
                </field>
                <field name="blogHeaderIcon" type="text" label="Blog Header Icon"
                    description="Blog Header Icon Class"/>
                <field name="projectHeaderIcon" type="text" label="Project Header Icon"
                    description="Project Header Icon Class"/>
                <field name="overrideColor" type="radio" label="Override Color" class="btn-group btn-group-yesno"
                    description="Override Color" default="0">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="colorSkin" type="color" default="#F54F36" 
                    label="Template Color"
                    description="Template Color"/>
                <field name="error" type="menuitem" published="1"
                    label="Error Page Menu"
                    description="The Menu page to redirect to if request page is not found"/>

            </fieldset>
        </fields>
    </config>

</extension>